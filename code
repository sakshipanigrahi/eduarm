#include <stdint.h>
#include <string.h>
#include "inc/tm4c123gh6pm.h"

/* ============================================================
   LAB 4 - LED + 7-SEGMENT + UART + KEYPAD STOPWATCH

   PORT B -> SEGMENT MAPPING  (common cathode: 1 = segment ON)
   PB0 = a  0x01      PB4 = e  0x10
   PB1 = b  0x02      PB5 = f  0x20
   PB2 = c  0x04      PB6 = g  0x40
   PB3 = d  0x08      PB7 = dp 0x80

   PORT A -> MODULE (DIGIT POSITION) MAPPING
   PA7 = 0x80 -> Module 1 (leftmost)
   PA6 = 0x40 -> Module 2
   PA5 = 0x20 -> Module 3
   PA4 = 0x10 -> Module 4 (rightmost)

   PORT A (UART)    PA0 = U0RX, PA1 = U0TX

   PORT F
   PF1 red, PF2 blue, PF3 green (outputs)
   PF4 = SW1 (input, pull-up)   PF0 = SW2 (input, pull-up)

   4x4 KEYPAD (EduARM4)
   PC4-PC7 = columns 0-3  (inputs, pull-up, INTERRUPT on falling edge)
   PE0-PE3 = rows 0-3     (open-drain outputs, idle = all LOW)

   ------------------------------------------------------------
   WHEN THE STOPWATCH IS DISABLED (normal mode, same as before)
     Module 1 = 'r' (running) or 'P' (paused)
     Module 2 = colour number
     Module 3 = letter 'S'
     Module 4 = rate number
     SW1 alone -> next RATE     SW2 alone -> next COLOUR
     SW1 + SW2 -> RUN / PAUSE   (rate/colour refused while paused)

   WHEN THE STOPWATCH IS ENABLED
     The four modules show  SS.CC  (seconds . hundredths)
     PA7 = seconds tens, PA6 = seconds units (dot lit),
     PA5 = hundredths tens, PA4 = hundredths units
     The LED keeps blinking and the switches keep working.

   STOPWATCH CONTROL (keypad key = typed word, they do the SAME thing)
     Keypad key 1 / "enable" or "e" -> stopwatch ENABLE / DISABLE
     Keypad key 2 / "start"         -> stopwatch START / STOP (+reset)
     Keypad key 3 / "pause"         -> stopwatch PAUSE / RESUME
                    "disable" or "d" -> stopwatch DISABLE (forced)

   UART (type the word, then press Enter, lowercase only)
     rate / r        -> next RATE        (refused while LED paused)
     color/colour/c  -> next COLOUR      (refused while LED paused)
     t               -> LED RUN / PAUSE
     h               -> HELP
   ============================================================ */

#define SEG_0   0x3F
#define SEG_1   0x06
#define SEG_2   0x5B
#define SEG_3   0x4F
#define SEG_4   0x66
#define SEG_5   0x6D
#define SEG_6   0x7D
#define SEG_7   0x07
#define SEG_8   0x7F
#define SEG_9   0x6F
#define SEG_S   0x6D
#define SEG_r   0x31      /* segments a + e + f  -> r (running) */
#define SEG_P   0x73      /* segments a+b+e+f+g  -> capital P  (paused)  */

#define TICK         3180 /* inner loop count that gives about 1 ms */
#define WAIT_MS      50   /* how long to wait for the second switch */
#define KEY_DEBOUNCE 20   /* ms the keypad must stay steady          */

int colourDigits[8] = {SEG_0, SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7};
int rateDigits[8]   = {SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7, SEG_8};
int numDigits[10]   = {SEG_0, SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7, SEG_8, SEG_9};

/* ------------------------------------------------------------
   GLOBAL VARIABLES
   Separate functions cannot see variables inside main(), so
   anything shared lives out here.

   "volatile" = "this can change at any moment behind your back
   (from an interrupt), so always re-read it, never remember an
   old copy". Only variables touched by an INTERRUPT need it.
   ------------------------------------------------------------ */
int colorIndex = 0;     /* 0..7  -> which colour               */
int rateIndex  = 0;     /* 0..7  -> which blink speed          */
int paused     = 0;     /* 0 = LED running, 1 = LED paused     */

volatile uint32_t stopwatchMs      = 0;   /* elapsed time in ms (SysTick adds to it) */
volatile uint8_t  stopwatchEnabled = 0;   /* 1 = stopwatch shown on the display      */
volatile uint8_t  stopwatchRunning = 0;   /* 1 = started                             */
volatile uint8_t  stopwatchPaused  = 0;   /* 1 = frozen                              */
volatile uint8_t  keypadEvent      = 0;   /* set by the keypad interrupt             */

/* ============================================================
   INTERRUPT HANDLERS
   These names must match the startup file's vector table.
   ============================================================ */

/* SysTick fires automatically every 1 ms (set up in main()).
   If the stopwatch is enabled + running + not paused, add 1 ms.
   Wraps to 0 after 59.99 seconds.                              */
void SysTick_Handler(void)
{
    if (stopwatchEnabled == 1 && stopwatchRunning == 1 && stopwatchPaused == 0)
    {
        stopwatchMs++;
        if (stopwatchMs >= 60000)
        {
            stopwatchMs = 0;
        }
    }
}

/* Keypad interrupt: a key was pressed (a column fell LOW).
   Kept tiny on purpose: clear the flag, switch the keypad
   interrupt OFF (so bouncing cannot fire it again and again),
   and leave a note for main(). KeypadService() does the work. */
void GPIOPortC_Handler(void)
{
    uint32_t triggered;

    triggered = GPIO_PORTC_MIS_R & 0xF0;
    if (triggered != 0)
    {
        GPIO_PORTC_ICR_R = triggered;
        GPIO_PORTC_IM_R &= ~0xF0;
        keypadEvent = 1;
    }
}

/* The friend's startup file points the Port F slot at this name,
   so it must exist or the linker complains. The Port F interrupt
   is never switched on (your SW1/SW2 are read by polling), so
   this never actually runs.                                     */
void GPIOPortF_Handler(void)
{
    GPIO_PORTF_ICR_R = 0xFF;
}

/* ============================================================
   UART0 SETUP - 16 MHz clock, 115200 baud, 8N1.
   PA0 = RX, PA1 = TX.  (Port A clock is switched on in main().)
   ============================================================ */
void UART0_Init(void)
{
    int k;

    SYSCTL_RCGCUART_R |= 0x01;          /* power on UART0              */
    for (k = 0; k < 10; k++);           /* let the clock settle        */

    GPIO_PORTA_AFSEL_R |= 0x03;         /* PA0, PA1 -> special function */
    GPIO_PORTA_PCTL_R &= ~0xFF;
    GPIO_PORTA_PCTL_R |= 0x11;          /* ...and the special function is UART */
    GPIO_PORTA_DEN_R |= 0x03;           /* make PA0, PA1 digital       */

    UART0_CTL_R = 0;                    /* UART off while we configure */
    UART0_IBRD_R = 8;                   /* 16 MHz / (16 x 115200) = 8.68 */
    UART0_FBRD_R = 44;                  /* 0.68 x 64 + 0.5 = 44         */
    UART0_LCRH_R = 0x70;                /* 8 bits, FIFO on             */
    UART0_CTL_R = 0x301;                /* UART on, TX on, RX on       */
}

/* send ONE letter (waits if the send box is full) */
void UART0_Write(char c)
{
    while (UART0_FR_R & 0x20);          /* bit5 = TX FIFO full */
    UART0_DR_R = c;
}

/* send a whole text, letter by letter */
void UART0_String(char *str)
{
    while (*str)
    {
        UART0_Write(*str);
        str++;
    }
}

/* ============================================================
   STOPWATCH ACTIONS
   The keypad AND the typed UART words both call these same
   three functions, so "press key 1" and "type enable" can
   never behave differently.
   ============================================================ */
void StopwatchEnableDisable(void)
{
    if (stopwatchEnabled == 0)
    {
        stopwatchEnabled = 1;
        stopwatchRunning = 0;
        stopwatchPaused  = 0;
        stopwatchMs      = 0;
        UART0_String("\r\nStopwatch Enabled\r\n");
    }
    else
    {
        stopwatchEnabled = 0;
        stopwatchRunning = 0;
        stopwatchPaused  = 0;
        stopwatchMs      = 0;
        UART0_String("\r\nStopwatch Disabled\r\n");
    }
}

void StopwatchStartStop(void)
{
    if (stopwatchEnabled == 0)
    {
        UART0_String("\r\nStopwatch is disabled\r\n");
    }
    else if (stopwatchRunning == 0)
    {
        stopwatchMs      = 0;
        stopwatchRunning = 1;
        stopwatchPaused  = 0;
        UART0_String("\r\nStopwatch Started\r\n");
    }
    else
    {
        stopwatchMs      = 0;
        stopwatchRunning = 0;
        stopwatchPaused  = 0;
        UART0_String("\r\nStopwatch Stopped\r\n");
    }
}

void StopwatchPauseResume(void)
{
    if (stopwatchEnabled == 0 || stopwatchRunning == 0)
    {
        UART0_String("\r\nStart the stopwatch first\r\n");
    }
    else if (stopwatchPaused == 0)
    {
        stopwatchPaused = 1;
        UART0_String("\r\nStopwatch Paused\r\n");
    }
    else
    {
        stopwatchPaused = 0;
        UART0_String("\r\nStopwatch Resumed\r\n");
    }
}

/* ============================================================
   WHAT EACH TYPED WORD DOES
   strcmp(a, b) gives 0 when the two texts are IDENTICAL, so
   strcmp(word, "rate") == 0 means "word is exactly 'rate'".
   ============================================================ */
void ProcessCommand(char *word)
{
    if (strcmp(word, "color") == 0 || strcmp(word, "colour") == 0 || strcmp(word, "c") == 0)
    {
        if (paused == 1)                 /* same rule as the switches: no change while paused */
        {
            UART0_String("\r\nPaused - cannot change colour. Type t to resume.\r\n");
        }
        else
        {
            colorIndex = colorIndex + 1;
            if (colorIndex == 8)
            {
                colorIndex = 0;
            }
            UART0_String("\r\nColour incremented\r\n");
        }
    }
    else if (strcmp(word, "rate") == 0 || strcmp(word, "r") == 0)
    {
        if (paused == 1)
        {
            UART0_String("\r\nPaused - cannot change rate. Type t to resume.\r\n");
        }
        else
        {
            rateIndex = rateIndex + 1;
            if (rateIndex == 8)
            {
                rateIndex = 0;
            }
            UART0_String("\r\nRate incremented\r\n");
        }
    }
    else if (strcmp(word, "t") == 0)
    {
        if (paused == 0)
        {
            paused = 1;
            UART0_String("\r\nLED: PAUSED\r\n");
        }
        else
        {
            paused = 0;
            UART0_String("\r\nLED: RUNNING\r\n");
        }
    }
    else if (strcmp(word, "enable") == 0 || strcmp(word, "e") == 0)
    {
        StopwatchEnableDisable();
    }
    else if (strcmp(word, "disable") == 0 || strcmp(word, "d") == 0)
    {
        stopwatchEnabled = 0;            /* forced off, whatever the current state */
        stopwatchRunning = 0;
        stopwatchPaused  = 0;
        stopwatchMs      = 0;
        UART0_String("\r\nStopwatch Disabled\r\n");
    }
    else if (strcmp(word, "start") == 0)
    {
        StopwatchStartStop();
    }
    else if (strcmp(word, "pause") == 0)
    {
        StopwatchPauseResume();
    }
    else if (strcmp(word, "h") == 0)
    {
        UART0_String(
            "\r\n"
            "============================\r\n"
            "COMMANDS (type then Enter)\r\n"
            "============================\r\n"
            "color / colour / c = next colour\r\n"
            "rate / r       = next rate\r\n"
            "t              = LED RUN / PAUSE\r\n"
            "enable / e     = stopwatch ENABLE/DISABLE\r\n"
            "disable / d    = stopwatch DISABLE (forced)\r\n"
            "start          = stopwatch START/STOP\r\n"
            "pause          = stopwatch PAUSE/RESUME\r\n"
            "h              = HELP\r\n"
            "============================\r\n"
        );
    }
    else
    {
        UART0_String("\r\nUnknown command\r\n");
    }
}

/* ============================================================
   UART POLL - called ONCE every ~1 ms from inside the loops.
   It NEVER waits: if no letter has arrived it returns at once,
   so the 7-segment refresh and your switch timing are not
   disturbed. Letters pile up on a "notepad" (cmdBuffer); when
   Enter arrives the word is run and the notepad is wiped.
   ============================================================ */
void UART_Poll(void)
{
    static char cmdBuffer[16];     /* the notepad (static = remembers between calls) */
    static int  cmdIndex = 0;      /* how many letters are on the notepad            */
    char c;

    if (UART0_FR_R & 0x10)         /* bit4 = RX empty -> nothing typed, leave */
    {
        return;
    }

    c = UART0_DR_R & 0xFF;         /* take the letter */

    if (c == '\r' || c == '\n')                    /* Enter */
    {
        if (cmdIndex > 0)
        {
            cmdBuffer[cmdIndex] = '\0';            /* mark the end of the word */
            ProcessCommand(cmdBuffer);
        }
        cmdIndex = 0;                              /* wipe the notepad */
        UART0_String("\r\n");
    }
    else if (c == 0x08 || c == 0x7F)               /* Backspace */
    {
        if (cmdIndex > 0)
        {
            cmdIndex = cmdIndex - 1;               /* forget last letter */
            UART0_String("\b \b");                 /* erase it on screen */
        }
    }
    else if (cmdIndex < 15)                        /* normal letter, room left */
    {
        cmdBuffer[cmdIndex] = c;
        cmdIndex = cmdIndex + 1;
        UART0_Write(c);                            /* echo so you see what you typed */
    }
    /* notepad full: extra letters are ignored until Enter */
}

/* ============================================================
   KEYPAD
   ------------------------------------------------------------
   KeypadScan: drive ONE row LOW at a time and see which column
   falls LOW. Returns key number 1..16, or 0 for "none".
     key = row * 4 + column + 1      (so key 1 = row0/col0,
                                      key 2 = row0/col1,
                                      key 3 = row0/col2 ...)
   The settle delay is long because the row lines are open-drain
   and rise slowly through a weak pull-up; a short delay can
   read the previous row's leftover LOW as a key press.
   ============================================================ */
uint8_t KeypadScan(void)
{
    int row;
    int d;
    uint8_t columns;
    uint8_t key = 0;

    for (row = 0; row < 4 && key == 0; row++)
    {
        GPIO_PORTE_DATA_R |= 0x0F;                 /* release all rows            */
        GPIO_PORTE_DATA_R &= ~(1 << row);          /* pull THIS row low           */

        for (d = 0; d < 4000; d++);                /* let the line settle         */

        columns = GPIO_PORTC_DATA_R & 0xF0;

        if (columns == 0xE0)      key = (row * 4) + 1;   /* col 0 low */
        else if (columns == 0xD0) key = (row * 4) + 2;   /* col 1 low */
        else if (columns == 0xB0) key = (row * 4) + 3;   /* col 2 low */
        else if (columns == 0x70) key = (row * 4) + 4;   /* col 3 low */
    }

    GPIO_PORTE_DATA_R &= ~0x0F;                    /* back to idle: all rows low  */
    return key;
}

/* Switch the keypad interrupt back ON, ready for the next press */
void KeypadRearm(void)
{
    GPIO_PORTC_ICR_R = 0xF0;
    GPIO_PORTC_IM_R |= 0xF0;
    keypadEvent = 0;
}

/* ------------------------------------------------------------
   KeypadService - called ONCE every ~1 ms. It never waits.
   It is a tiny 3-step machine (phase remembers the step):
     phase 0 : idle, watching for the interrupt's note
     phase 1 : key went down; wait 20 ms for the bounce to
               settle, then scan which key it is and act
     phase 2 : wait until the key has been released for 20 ms,
               then switch the interrupt back on
   (A held key therefore fires only ONCE, and the display and
   UART keep running while you hold it.)
   ------------------------------------------------------------ */
void KeypadService(void)
{
    static int phase = 0;
    static int count = 0;
    uint8_t key;

    if (phase == 0)
    {
        if (keypadEvent == 1)
        {
            phase = 1;
            count = 0;
        }
    }
    else if (phase == 1)
    {
        count++;
        if (count >= KEY_DEBOUNCE)
        {
            key = KeypadScan();

            if (key == 1)
            {
                StopwatchEnableDisable();
            }
            else if (key == 2)
            {
                StopwatchStartStop();
            }
            else if (key == 3)
            {
                StopwatchPauseResume();
            }

            if (key != 0)
            {
                phase = 2;                 /* wait for release */
                count = 0;
            }
            else
            {
                KeypadRearm();             /* it was only noise */
                phase = 0;
            }
        }
    }
    else
    {
        if ((GPIO_PORTC_DATA_R & 0xF0) == 0xF0)    /* all columns high = released */
        {
            count++;
            if (count >= KEY_DEBOUNCE)
            {
                KeypadRearm();
                phase = 0;
            }
        }
        else
        {
            count = 0;
        }
    }
}

/* One call = everything that listens for input apart from the switches */
void Service(void)
{
    UART_Poll();
    KeypadService();
}

/* ============================================================
   DISPLAY - each call lights ONE module (turns 0..3 take
   turns), exactly like your original, so the loops below can
   keep calling it once per ~1 ms tick.
   ============================================================ */
void ShowDigit(int colorIndex, int rateIndex, int paused)
{
    static int turn = 0;

    GPIO_PORTA_DATA_R &= ~0xF0;      /* blank all four modules first */

    if (turn == 0)
    {
        GPIO_PORTB_DATA_R = colourDigits[colorIndex];
        GPIO_PORTA_DATA_R |= 0x40;   /* PA6 -> Module 2 */
    }
    if (turn == 1)
    {
        GPIO_PORTB_DATA_R = SEG_S;
        GPIO_PORTA_DATA_R |= 0x20;   /* PA5 -> Module 3 */
    }
    if (turn == 2)
    {
        GPIO_PORTB_DATA_R = rateDigits[rateIndex];
        GPIO_PORTA_DATA_R |= 0x10;   /* PA4 -> Module 4 */
    }
    if (turn == 3)
    {
        if (paused == 1)
        {
            GPIO_PORTB_DATA_R = SEG_P;
        }
        else
        {
            GPIO_PORTB_DATA_R = SEG_r;
        }
        GPIO_PORTA_DATA_R |= 0x80;   /* PA7 -> Module 1 */
    }

    turn = turn + 1;
    if (turn == 4)
    {
        turn = 0;
    }
}

/* Stopwatch version: shows SS.CC. The time is copied ONCE at the
   start of each 4-digit round so all four digits belong to the
   same instant (the interrupt keeps changing stopwatchMs).      */
void ShowStopwatchDigit(void)
{
    static int turn = 0;
    static uint32_t snapshot = 0;
    int seconds;
    int centis;

    if (turn == 0)
    {
        snapshot = stopwatchMs;
    }

    seconds = (int)(snapshot / 1000);
    centis  = (int)((snapshot % 1000) / 10);

    GPIO_PORTA_DATA_R &= ~0xF0;      /* blank all four modules first */

    if (turn == 0)
    {
        GPIO_PORTB_DATA_R = numDigits[centis % 10];
        GPIO_PORTA_DATA_R |= 0x10;   /* PA4 -> hundredths units */
    }
    if (turn == 1)
    {
        GPIO_PORTB_DATA_R = numDigits[centis / 10];
        GPIO_PORTA_DATA_R |= 0x20;   /* PA5 -> hundredths tens  */
    }
    if (turn == 2)
    {
        GPIO_PORTB_DATA_R = numDigits[seconds % 10] | 0x80;   /* + decimal point */
        GPIO_PORTA_DATA_R |= 0x40;   /* PA6 -> seconds units    */
    }
    if (turn == 3)
    {
        GPIO_PORTB_DATA_R = numDigits[seconds / 10];
        GPIO_PORTA_DATA_R |= 0x80;   /* PA7 -> seconds tens     */
    }

    turn = turn + 1;
    if (turn == 4)
    {
        turn = 0;
    }
}

/* Picks which display to draw: stopwatch time or the LED status */
void UpdateDisplay(void)
{
    if (stopwatchEnabled == 1)
    {
        ShowStopwatchDigit();
    }
    else
    {
        ShowDigit(colorIndex, rateIndex, paused);
    }
}

int main(void)
{
    int colors[8] = {0x00, 0x02, 0x08, 0x04, 0x0E, 0x06, 0x0A, 0x0C};
    int rates[8]  = {2500, 2000, 1500, 1250, 1000, 500, 250, 100};
    int sw1 = 1;
    int sw2 = 1;
    int s1now, s2now;
    int waiting = 0;               /* 0 = nothing pending, 1 = SW1, 2 = SW2 */
    int waitCount = 0;             /* ticks counted since the note was made */
    int i, j;
    int delayLimit;

    /* ---- clocks: bit0 = A, bit1 = B, bit2 = C, bit4 = E, bit5 = F ---- */
    SYSCTL_RCGC2_R |= 0x00000037;
    for (j = 0; j < 10; j++);          /* let the clock settle */

    /* ---- Port F: LED + switches ---- */
    GPIO_PORTF_LOCK_R = 0x4C4F434B;
    GPIO_PORTF_CR_R = 0x01;
    GPIO_PORTF_DIR_R = 0x0E;
    GPIO_PORTF_PUR_R = 0x11;
    GPIO_PORTF_DEN_R = 0x1F;

    /* ---- Port A: PA4, PA5, PA6, PA7 drive the four modules ---- */
    GPIO_PORTA_DIR_R |= 0xF0;
    GPIO_PORTA_DEN_R |= 0xF0;

    /* ---- Port B: PB0..PB7 drive the eight segments ---- */
    GPIO_PORTB_DIR_R = 0xFF;
    GPIO_PORTB_DEN_R = 0xFF;

    /* ---- Port C: keypad columns PC4-PC7 (inputs, pull-ups) ---- */
    GPIO_PORTC_DIR_R &= ~0xF0;
    GPIO_PORTC_DEN_R |= 0xF0;
    GPIO_PORTC_PUR_R |= 0xF0;
    GPIO_PORTC_IS_R  &= ~0xF0;         /* edge-sensitive            */
    GPIO_PORTC_IBE_R &= ~0xF0;         /* one edge only...          */
    GPIO_PORTC_IEV_R &= ~0xF0;         /* ...the FALLING edge       */
    GPIO_PORTC_ICR_R  = 0xF0;          /* clear any old flag        */
    GPIO_PORTC_IM_R  |= 0xF0;          /* allow these 4 pins to interrupt */

    /* ---- Port E: keypad rows PE0-PE3 (open-drain, idle LOW) ---- */
    GPIO_PORTE_DIR_R |= 0x0F;
    GPIO_PORTE_DEN_R |= 0x0F;
    GPIO_PORTE_ODR_R |= 0x0F;
    GPIO_PORTE_DATA_R &= ~0x0F;

    /* ---- NVIC: allow Port C (interrupt number 2) ---- */
    NVIC_EN0_R |= (1 << 2);

    /* ---- SysTick: 16 MHz clock, 1 ms period ---- */
    NVIC_ST_CTRL_R = 0;
    NVIC_ST_RELOAD_R = 15999;          /* 16000 ticks = 1 ms */
    NVIC_ST_CURRENT_R = 0;
    NVIC_ST_CTRL_R = 0x07;             /* clock on, interrupt on, run */

    /* ---- UART (uses PA0/PA1, does not touch PA4-PA7) ---- */
    UART0_Init();

    /* ---- Master switch for interrupts. Nothing above fires until now. ---- */
    __asm(" cpsie i");

    UART0_String(
        "\r\n"
        "============================\r\n"
        "           LAB 4\r\n"
        "============================\r\n"
        "SW1       : RATE\r\n"
        "SW2       : COLOUR\r\n"
        "SW1+SW2   : RUN / PAUSE\r\n"
        "Keypad 1  : Stopwatch ENABLE/DISABLE\r\n"
        "Keypad 2  : Stopwatch START/STOP\r\n"
        "Keypad 3  : Stopwatch PAUSE/RESUME\r\n"
        "\r\n"
        "UART COMMANDS (type then Enter):\r\n"
        "color / colour = next colour\r\n"
        "rate           = next rate\r\n"
        "t              = LED RUN / PAUSE\r\n"
        "enable / start / pause = stopwatch\r\n"
        "h              = HELP\r\n"
        "============================\r\n"
    );

    while (1)
    {
        /* ================= LED ON HALF ================= */
        GPIO_PORTF_DATA_R = colors[colorIndex];
        delayLimit = rates[rateIndex];
        for (i = 0; i < delayLimit; i++)
        {
            s1now = GPIO_PORTF_DATA_R & 0x10;
            s2now = GPIO_PORTF_DATA_R & 0x01;

            if (s1now == 0 && s2now == 0 && (sw1 != 0 || sw2 != 0))
            {
                waiting = 0;                 /* cancel any pending action */
                if (paused == 0)
                {
                    paused = 1;
                }
                else
                {
                    paused = 0;
                }
            }
            else if (s1now == 0 && sw1 != 0 && paused == 0)
            {
                waiting = 1;                 /* note it, do not act yet */
                waitCount = 0;
            }
            else if (s2now == 0 && sw2 != 0 && paused == 0)
            {
                waiting = 2;
                waitCount = 0;
            }

            if (waiting != 0)
            {
                waitCount = waitCount + 1;
                if (waitCount == WAIT_MS)    /* partner never arrived */
                {
                    if (waiting == 1)
                    {
                        rateIndex = rateIndex + 1;
                        if (rateIndex == 8)
                        {
                            rateIndex = 0;
                        }
                    }
                    else
                    {
                        colorIndex = colorIndex + 1;
                        if (colorIndex == 8)
                        {
                            colorIndex = 0;
                        }
                    }
                    waiting = 0;
                }
            }

            sw1 = s1now;
            sw2 = s2now;

            Service();                       /* UART + keypad (never waits) */

            while (paused == 1)
            {
                s1now = GPIO_PORTF_DATA_R & 0x10;
                s2now = GPIO_PORTF_DATA_R & 0x01;
                if (s1now == 0 && s2now == 0 && (sw1 != 0 || sw2 != 0))
                {
                    paused = 0;
                }
                sw1 = s1now;
                sw2 = s2now;
                Service();                   /* so "t" can un-pause and the keypad still works */
                UpdateDisplay();
                for (j = 0; j < TICK; j++);
            }

            GPIO_PORTF_DATA_R = colors[colorIndex];
            UpdateDisplay();
            for (j = 0; j < TICK; j++);
        }

        /* ================= LED OFF HALF ================= */
        GPIO_PORTF_DATA_R = 0x00;
        delayLimit = rates[rateIndex];
        for (i = 0; i < delayLimit; i++)
        {
            s1now = GPIO_PORTF_DATA_R & 0x10;
            s2now = GPIO_PORTF_DATA_R & 0x01;

            if (s1now == 0 && s2now == 0 && (sw1 != 0 || sw2 != 0))
            {
                waiting = 0;
                if (paused == 0)
                {
                    paused = 1;
                }
                else
                {
                    paused = 0;
                }
            }
            else if (s1now == 0 && sw1 != 0 && paused == 0)
            {
                waiting = 1;
                waitCount = 0;
            }
            else if (s2now == 0 && sw2 != 0 && paused == 0)
            {
                waiting = 2;
                waitCount = 0;
            }

            if (waiting != 0)
            {
                waitCount = waitCount + 1;
                if (waitCount == WAIT_MS)
                {
                    if (waiting == 1)
                    {
                        rateIndex = rateIndex + 1;
                        if (rateIndex == 8)
                        {
                            rateIndex = 0;
                        }
                    }
                    else
                    {
                        colorIndex = colorIndex + 1;
                        if (colorIndex == 8)
                        {
                            colorIndex = 0;
                        }
                    }
                    waiting = 0;
                }
            }

            sw1 = s1now;
            sw2 = s2now;

            Service();                                    /* UART + keypad (never waits) */

            while (paused == 1)
            {
                GPIO_PORTF_DATA_R = colors[colorIndex];   /* hold the colour while frozen */
                s1now = GPIO_PORTF_DATA_R & 0x10;
                s2now = GPIO_PORTF_DATA_R & 0x01;
                if (s1now == 0 && s2now == 0 && (sw1 != 0 || sw2 != 0))
                {
                    paused = 0;
                }
                sw1 = s1now;
                sw2 = s2now;
                Service();                                /* so "t" can un-pause and the keypad still works */
                UpdateDisplay();
                for (j = 0; j < TICK; j++);
            }
            GPIO_PORTF_DATA_R = 0x00;                     /* OFF half continues */

            UpdateDisplay();
            for (j = 0; j < TICK; j++);
        }
    }
}
